{
  "expo": {
    "name": "Legity League",
    "slug": "legity-league",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.legityleague.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b0d1a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.legityleague.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Legity League reads your sleep so your nights count in the league.",
          "NSHealthUpdateUsageDescription": "Legity League only reads your sleep and never writes to Apple Health. iOS requires this description for any app that uses Health.",
          "background": true
        }
      ],
      "./plugins/withNoScriptSandbox",
      "expo-router",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0b0d1a",
          "imageWidth": 220
        }
      ],
      "expo-background-task"
    ],
    "scheme": "legityleague",
    "backgroundColor": "#0b0d1a",
    "owner": "liam-highducheck",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "10e03946-8e0d-441e-9420-018a9f45215c"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/10e03946-8e0d-441e-9420-018a9f45215c"
    }
  }
}
